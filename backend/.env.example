APP_NAME=TestFlow
APP_ENV=development

# Use service name 'mysql' when running inside Docker, 'localhost' for local dev
DATABASE_URL=mysql+pymysql://testflow:testflow@localhost:3306/testflow

JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
